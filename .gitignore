.env

# Ignore all of bench, then re-include ONLY the FeelJapanK app.
/bench/*
!/bench/apps/
/bench/apps/*
!/bench/apps/feeljapank_crm/

# Generated/local content inside the tracked app.
/bench/apps/feeljapank_crm/node_modules/
/bench/apps/feeljapank_crm/frontend/node_modules/
/bench/apps/feeljapank_crm/.ruff_cache/
/bench/apps/feeljapank_crm/**/__pycache__/
/bench/apps/feeljapank_crm/**/*.pyc
/bench/apps/feeljapank_crm/feeljapank_crm/public/node_modules

# Source maps are reproducible build output and are not part of the
# source baseline.
/bench/apps/feeljapank_crm/feeljapank_crm/public/dist/*.map
